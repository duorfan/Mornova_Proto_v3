# Mornova backend seams — placeholders only. Copy to .env.local and fill in.
# Do NOT commit real secrets. .env.local is gitignored.

# --- Google Calendar (app/api/calendar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# --- Weather (app/api/weather) ---
# Optional: the UI currently uses Open-Meteo (no key). Reserved for a keyed provider.
WEATHER_API_KEY=

# --- LLM reasoning (app/api/reason) ---
# Anthropic by default; can be swapped for another provider.
ANTHROPIC_API_KEY=
